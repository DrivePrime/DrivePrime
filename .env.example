# Copy to .env and fill in. These are PUBLIC client values (Supabase project URL and
# anon/publishable key); data protection relies on Row Level Security, not on hiding them.
# Never put a service_role / secret key in any VITE_* variable: it would ship to browsers.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
